<?xml version="1.0" encoding="utf-8"?>
<!--
  Wzorzec web.config witryny GUI na MonsterASP (plan hosting-monsterasp, Faza 4).
  publikuj.ps1 -Cel MonsterAsp podstawia w nim hosty obu witryn (z -HostGui
  i -HostApi) i kładzie wynik w korzeniu paczki GUI. Plik w repo nie jest
  gotowym web.config — bez podstawienia skrypt odmawia.

  Witryna uruchamia react-router-serve pod HttpPlatformHandlerem, tak jak
  sonda Node z Fazy 1 (context/changes/hosting-monsterasp/sonda/node/web.config,
  wzorzec help.monsterasp.net/websites/frameworks/nodejs). Node na serwerze to
  v22.20.0, poniżej engines React Routera (werdykt G1: ryzyko zaakceptowane
  po pełnym E2E na tej wersji).

  Żadnych sekretów w tym pliku. Auth__InternalApiSecret (wspólny sekret
  Node→API, ta sama wartość co w witrynie API) ustawia się w panelu witryny:
  Scripting → Environment variables. TREEGRID_API_URL sekretem nie jest.
-->
<configuration>
  <system.webServer>

    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>

    <!--
      Wymuszenie HTTPS. Sonda (G4) pokazała, że witryna Node odpowiada także
      po http:// — a ciasteczko sesji __Host-tg-sesja jest Secure, więc po
      HTTP przeglądarka po cichu je odrzuca i logowanie zapętla się na
      /logowanie bez komunikatu. Stąd 301 na https z tą samą ścieżką i query.

      Host w adresie docelowym jest stały (podstawiony przez publikuj.ps1),
      a nie brany z nagłówka Host żądania: przekierowanie nie może prowadzić
      tam, gdzie wskaże wysyłający.

      Warunek HTTPS = off działa tylko wtedy, gdy TLS kończy się w IIS. Sonda
      widziała xForwardedProto "https" i "http" zależnie od żądania, co na to
      wskazuje, ale Faza 5 sprawdza oba kierunki. Jeśli https:// też dostanie
      301 (pętla przekierowań), MonsterASP terminuje TLS przed IIS i warunek
      trzeba zmienić na input="{HTTP_X_FORWARDED_PROTO}" pattern="^http$".
      Brak modułu URL Rewrite na serwerze daje 500.19 przy pierwszym wgraniu.
    -->
    <rewrite>
      <rules>
        <rule name="TreeGrid HTTP na HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Redirect" url="https://{{HOST_GUI}}/{R:1}" redirectType="Permanent" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>

    <!--
      path="*" kieruje każde żądanie do Node, także pliki statyczne z
      build/client (serwuje je react-router-serve), więc katalog logs nie jest
      dostępny przez HTTP. Do logs\node-stdout* trafia stdout i stderr serwera,
      w tym linie JSON event:"api_failure" (app/lib/log.server.ts) — jedyne
      miejsce, w którym widać przyczynę porażki wywołania API.

      PORT: react-router-serve parsuje go jako liczbę, a HttpPlatformHandler
      podaje numer portu w HTTP_PLATFORM_PORT. NODE_ENV=production jawnie, bo
      trasa /wzornik istnieje tylko w development.

      TREEGRID_API_URL: osobna witryna API, zawsze po https:// — po http://
      wspólny sekret szedłby otwartym tekstem. Bez podścieżki /tg-api: wariant
      aplikacji podrzędnej odpadł w werdykcie Fazy 1.
    -->
    <httpPlatform processPath="node" arguments="node_modules\@react-router\serve\dist\cli.js build\server\index.js" startupTimeLimit="60" stdoutLogEnabled="true" stdoutLogFile=".\logs\node-stdout">
      <environmentVariables>
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="NODE_ENV" value="production" />
        <environmentVariable name="TREEGRID_API_URL" value="https://{{HOST_API}}" />
      </environmentVariables>
    </httpPlatform>

  </system.webServer>
</configuration>
