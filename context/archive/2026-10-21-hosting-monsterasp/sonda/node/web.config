<?xml version="1.0" encoding="utf-8"?>
<!--
  Sonda Node (Faza 1 planu hosting-monsterasp). Kopia wzorca
  help.monsterasp.net/websites/frameworks/nodejs (stan 2026-10-05) z dwiema
  zmianami: stdoutLogEnabled="true" (wyjście node trafia do wwwroot\logs)
  i nazwa pliku logu node-stdout. Plik leży w korzeniu witryny (wwwroot),
  więc dziedziczy go aplikacja podrzędna /tg-api — dlatego web.config sondy
  .NET usuwa handler httpPlatformHandler.
-->
<configuration>
  <system.webServer>

    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>

    <httpPlatform processPath="node" arguments=".\server.js" startupTimeLimit="20" stdoutLogEnabled="true" stdoutLogFile=".\logs\node-stdout">
      <environmentVariables>
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="NODE_ENV" value="production" />
      </environmentVariables>
    </httpPlatform>

  </system.webServer>
</configuration>
