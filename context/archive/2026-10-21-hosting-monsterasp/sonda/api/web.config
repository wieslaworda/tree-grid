<?xml version="1.0" encoding="utf-8"?>
<!--
  Sonda .NET jako aplikacja podrzędna /tg-api (Faza 1 planu hosting-monsterasp).
  Trafia do wwwroot\tg-api razem z wynikiem dotnet publish.

  IIS dziedziczy sekcję handlers z web.config korzenia witryny, a tam stoi
  httpPlatformHandler z path="*" — bez <remove> każde żądanie do /tg-api
  poszłoby do procesu node, a nie do tej aplikacji. Drugi <remove> chroni
  przed duplikatem nazwy aspNetCore, gdyby korzeń albo serwer już go deklarował.
-->
<configuration>
  <system.webServer>
    <handlers>
      <remove name="httpPlatformHandler" />
      <remove name="aspNetCore" />
      <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
    </handlers>
    <aspNetCore processPath="dotnet" arguments=".\Sonda.dll" hostingModel="inprocess" stdoutLogEnabled="true" stdoutLogFile=".\logs\stdout" />
  </system.webServer>
</configuration>
