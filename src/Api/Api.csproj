<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      Identyfikator magazynu `user-secrets`. Nie jest sekretem — sam wskazuje
      plik poza katalogiem projektu, w którym w Development leżą wartości
      `Auth:SessionSigningKey` i — gdy pętla deweloperska ma wysyłać prawdziwą
      pocztę — `Mail:Smtp:UserName`, `Mail:Smtp:Password` i `Mail:From`. Bez tego wpisu
      `dotnet user-secrets` nie ma czego otworzyć, a dostawca konfiguracji
      z `user-secrets` w ogóle się nie rejestruje.
    -->
    <UserSecretsId>978dbb71-8edc-4076-8a5a-e79c491bf6b3</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.18.1" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <!--
      Przypięcie zależności przechodniej MailKit → MimeKit, który sam rozwiązuje
      10.0.0 z podatnościami DoS (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7,
      naprawione w 10.0.13). Do zdjęcia, gdy MimeKit sam wymaga naprawionej
      wersji (impl-review zakladanie-konta, F5).
    -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Reguły uwierzytelniania są `internal` — to szczegóły tej aplikacji, nie
      biblioteka. Testy mają je jednak sprawdzać bez podnoszenia hosta, więc
      widzi je projekt testowy i tylko on.
    -->
    <InternalsVisibleTo Include="Api.Tests" />
  </ItemGroup>

</Project>
