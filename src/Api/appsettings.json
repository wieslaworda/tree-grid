{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://127.0.0.1:5180"
      }
    }
  },
  "ConnectionStrings": {
    "Default": "Data Source=db/treegrid.db"
  },
  "Identity": {
    "Lockout": {
      "MaxFailedAccessAttempts": 5,
      "LockoutMinutes": 15
    }
  },
  "Auth": {
    "SessionSigningKey": "",
    "InternalApiSecret": "",
    "RegistrationRateLimit": {
      "PermitLimit": 5,
      "WindowMinutes": 60
    },
    "LoginRateLimit": {
      "PermitLimit": 20,
      "WindowMinutes": 1
    }
  },
  "Mail": {
    "Transport": "Smtp",
    "From": "",
    "Smtp": {
      "Host": "smtp.gmail.com",
      "Port": 587,
      "UserName": "",
      "Password": ""
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "FileLogging": {
    "Directory": "Log"
  },
  "AllowedHosts": "*"
}
